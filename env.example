# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env (já está no .gitignore).

# Conexão com o banco de dados SQL Server
DB_SERVER=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Credenciais de login do dashboard (tela de login da aplicação)
MASTER_USERNAME=
MASTER_PASSWORD=
COMPRAS_USERNAME=
COMPRAS_PASSWORD=

# Senhas por centro de custo (C Custo).
# Opção A: cole o JSON inteiro numa linha só aqui:
# CCUSTO_PASSWORDS={"1011": "xxxx", "1012": "xxxx"}
#
# Opção B (recomendada para o dicionário grande): aponte para um arquivo local
# CCUSTO_PASSWORDS_FILE=./ccusto_passwords.json
